   "source": [
    "# --- Box Plot: BTC vs ETH Transaction Amounts ---\n",
    "# Provides a summary of transaction amount spread and outliers for each currency.\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.boxplot(data=df, x='Currency', y='Amount', showfliers=False, palette='Set3')\n",
    "plt.yscale('log')  # Skewed data, so use log scale\n",
    "plt.title(\"Transaction Amounts by Currency (Box Plot, Log Scale)\")\n",
    "plt.ylabel(\"Transaction Amount (Log Scale)\")\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
