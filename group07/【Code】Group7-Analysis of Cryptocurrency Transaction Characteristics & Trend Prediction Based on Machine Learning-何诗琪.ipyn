   "outputs": [],
   "source": [
    "# --- Calculate time between transactions for each address ---\n",
    "# First, get all transactions (both sent and received) for each address\n",
    "all_sender_txs = df[['Sender_Address', 'Timestamp']].copy()\n",
    "all_sender_txs.columns = ['Address', 'Timestamp']\n",
    "all_sender_txs['Direction'] = 'Out'\n",
    "all_receiver_txs = df[['Receiver_Address', 'Timestamp']].copy()\n",
    "all_receiver_txs.columns = ['Address', 'Timestamp']\n",
    "all_receiver_txs['Direction'] = 'In'\n",
    "all_txs = pd.concat([all_sender_txs, all_receiver_txs])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
