    "# --- Activity by day of week ---\n",
    "top_address_txs['Weekday'] = top_address_txs['Timestamp'].dt.day_name()\n",
    "weekday_activity = top_address_txs.groupby('Weekday').size().reset_index(name='Transaction_Count')\n",
    "# Reorder days\n",
    "weekday_order = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']\n",
    "weekday_activity['Weekday'] = pd.Categorical(weekday_activity['Weekday'], categories=weekday_order, ordered=True)\n",
    "weekday_activity = weekday_activity.sort_values('Weekday')\n",
    "plt.figure(figsize=(12, 6))\n",
