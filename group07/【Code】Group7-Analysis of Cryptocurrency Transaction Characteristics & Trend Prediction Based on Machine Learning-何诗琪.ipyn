   "source": [
    "# --- Number of Transactions ---\n",
    "print(f\"Total number of transactions: {df.shape[0]}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "b008c3cd-9882-4143-b3b3-9706383b249c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Date Range: From 2025-03-03 04:37:41.537595+00:00 to 2025-05-11 15:10:41.695411+00:00\n"
     ]
    }
   ],
   "source": [
    "# --- Time Span: Min and Max Timestamp ---\n",
    "print(f\"Date Range: From {df['Timestamp'].min()} to {df['Timestamp'].max()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "4b5710fb-297e-42bb-a392-03ddeb1bc61e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Empty DataFrame\n",
      "Columns: [Missing Values, Percentage (%)]\n",
      "Index: []\n"
     ]
    }
   ],
   "source": [
    "# --- Missing Values Overview ---\n",
    "missing = df.isnull().sum()\n",
    "missing_percent = (missing / len(df)) * 100\n",
    "missing_df = pd.DataFrame({'Missing Values': missing, 'Percentage (%)': missing_percent})\n",
    "print(missing_df[missing_df['Missing Values'] > 0])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "162fb097-040d-4cd7-ab7b-2eefcb680146",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Missing Gas Prices (ETH only): 0\n",
      "Missing Gas Prices (BTC should be): 0\n"
     ]
    }
   ],
   "source": [
    "# --- Justification for Missing Gas Prices ---\n",
    "# Only ETH transactions have gas prices, so BTC entries show NaN which we filled with 0.\n",
    "eth_only_gas = df[df['Currency'] == 'ETH']['Gas_Price_Gwei'].isnull().sum()\n",
    "btc_only_gas = df[df['Currency'] == 'BTC']['Gas_Price_Gwei'].isnull().sum()\n",
    "print(f\"Missing Gas Prices (ETH only): {eth_only_gas}\")\n",
    "print(f\"Missing Gas Prices (BTC should be): {btc_only_gas}\")\n",
    "# Fill missing values if any\n",
    "df['Gas_Price_Gwei'].fillna(df['Gas_Price_Gwei'].median(), inplace=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "9c781f21-ac28-48b4-bf2b-c491c4e8f818",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# --- Distribution Across BTC and ETH ---\n",
    "currency_counts = df['Currency'].value_counts()\n",
    "plt.figure(figsize=(15, 4))\n",
    "\n",
    "# --- Bar Plot: Currency Distribution ---\n",
    "# Visualizes the count of BTC and ETH transactions.\n",
    "sns.barplot(x=currency_counts.index, y=currency_counts.values, palette='viridis')\n",
    "plt.title(\"Transaction Count by Cryptocurrency\")\n",
    "plt.ylabel(\"Number of Transactions\")\n",
    "plt.xlabel(\"Currency\")\n",
    "plt.grid(axis='y')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "acf02029-4a23-413b-9a7f-0b998cec9d58",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2.Transaction Trends Over Time"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "52f851bb-cb05-4326-911b-23991a358aed",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# --- Line Plot: Daily Transaction Volume ---\n",
    "# This plot shows the total number of daily transactions over time. \n",
    "# It helps us observe spikes in activity and general usage patterns. \n",
    "\n",
    "daily_txn = df.groupby(df['Timestamp'].dt.date).size().reset_index(name='Transaction_Count')\n",
    "plt.figure(figsize=(14, 6))\n",
    "sns.lineplot(data=daily_txn, x='Timestamp', y='Transaction_Count', color='blue')\n",
    "plt.title(\"Daily Transaction Volume\")\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"Number of Transactions\")\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show() "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "1f3ade12-b1d4-49ea-9b82-0500a731879c",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# --- Line Plot: BTC vs ETH Transactions Over Time ---\n",
    "# This plot compares BTC and ETH daily transaction trends. \n",
    "# It helps us see which blockchain had more usage on different days. \n",
    "\n",
    "df['Date'] = df['Timestamp'].dt.date\n",
    "daily_currency = df.groupby(['Date', 'Currency']).size().reset_index(name='Count')\n",
    "\n",
    "plt.figure(figsize=(14, 6))\n",
    "sns.lineplot(data=daily_currency, x='Date', y='Count', hue='Currency', palette='Set2')\n",
    "plt.title(\"BTC vs ETH Daily Transaction Count\")\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"Number of Transactions\")\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
