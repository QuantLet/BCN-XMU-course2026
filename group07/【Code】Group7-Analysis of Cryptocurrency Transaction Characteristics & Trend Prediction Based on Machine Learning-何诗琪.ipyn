       "top      Ethermine      ETH         Transfer          Confirmed    04-10-2025   \n",
       "freq         30005    25012            50000              50000           788   \n",
       "\n",
       "              Date    Weekday  \n",
       "count        50000      50000  \n",
       "unique          70          7  \n",
       "top     2025-04-10  Wednesday  \n",
       "freq           788       7377  "
      ]
     },
     "execution_count": 10,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Summary Statistics for Categorical Columns\n",
    "# Display the summary statistics (like count, unique, top, and freq) for categorical columns in the dataset\n",
    "df[categorical_columns].describe(include='all')"
   ]
  },
