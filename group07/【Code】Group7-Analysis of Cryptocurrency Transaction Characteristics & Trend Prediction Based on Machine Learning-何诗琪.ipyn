    "# --- Scatter Plot: Amount vs Transaction Fee ---\n",
    "# This shows whether larger transactions tend to pay higher fees.\n",
    "# Helps identify any correlation between transaction value and cost.\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.scatterplot(data=df, x='Amount', y='Transaction_Fee', hue='Currency', alpha=0.6)\n",
    "plt.xscale('log')\n",
    "plt.yscale('log')\n",
    "plt.title(\"Transaction Amount vs Fee (Log-Log Scale)\")\n",
    "plt.xlabel(\"Transaction Amount\")\n",
    "plt.ylabel(\"Transaction Fee\")\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
