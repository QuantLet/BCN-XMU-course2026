    "# --- Histogram: Overall Transaction Amounts (Log Scale) ---\n",
    "# Shows the distribution of all transaction amounts on a log scale.\n",
    "# Helps identify whether transactions are micro, normal, or macro in size.\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.histplot(df['Amount'], bins=100, log_scale=True, kde=True, color='teal')\n",
    "plt.title(\"Distribution of Transaction Amounts (Log Scale)\")\n",
    "plt.xlabel(\"Transaction Amount (Log Scale)\")\n",
    "plt.ylabel(\"Frequency\")\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
