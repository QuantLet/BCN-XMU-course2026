   "source": [
    "# From the perspective of transaction volume\n",
    "# --- Count transactions by sender ---\n",
    "sender_counts = df['Sender_Address'].value_counts().reset_index()\n",
    "sender_counts.columns = ['Address', 'Sent_Count']\n",
    "# Count transactions by receiver\n",
    "receiver_counts = df['Receiver_Address'].value_counts().reset_index()\n",
    "receiver_counts.columns = ['Address', 'Received_Count']\n",
    "# Merge to get complete picture of activity\n",
    "address_activity = pd.merge(sender_counts, receiver_counts, on='Address', how='outer').fillna(0)\n",
    "address_activity['Total_Transactions'] = address_activity['Sent_Count'] + address_activity['Received_Count']\n",
    "address_activity['Sent_Percentage'] = (address_activity['Sent_Count'] / address_activity['Total_Transactions'] * 100).round(2)\n",
    "# Sort by total transactions\n",
    "address_activity = address_activity.sort_values('Total_Transactions', ascending=False)\n",
    "print(f\"\\nTotal unique addresses: {len(address_activity)}\")\n",
    "print(\"\\nTop 10 most active addresses:\")\n",
    "print(address_activity.head(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "0154d025-ba91-4529-86a9-0212d1ad1bc6",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x800 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# --- Visualize top 20 addresses by activity ---\n",
    "plt.figure(figsize=(14, 8))\n",
    "top_addresses = address_activity.head(20)\n",
    "plt.barh(top_addresses['Address'], top_addresses['Total_Transactions'])\n",
    "plt.title('Top 20 Addresses by Transaction Count')\n",
    "plt.xlabel('Number of Transactions')\n",
    "plt.ylabel('Address')\n",
    "plt.gca().invert_yaxis()  # Highest at the top\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
