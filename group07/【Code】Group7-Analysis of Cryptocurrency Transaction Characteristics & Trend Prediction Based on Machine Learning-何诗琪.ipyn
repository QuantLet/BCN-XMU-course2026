   "source": [
    "# --- Calculate total and average amounts by sender ---\n",
    "sender_amounts = df.groupby('Sender_Address').agg({\n",
    "    'Amount': ['sum', 'mean', 'count'],\n",
    "    'Transaction_Fee': ['sum', 'mean']\n",
    "}).reset_index()\n",
    "sender_amounts.columns = ['Address', 'Total_Sent', 'Avg_Sent', 'Sent_Count', 'Total_Fee', 'Avg_Fee']\n",
    "# Calculate total and average amounts by receiver\n",
    "receiver_amounts = df.groupby('Receiver_Address').agg({\n",
    "    'Amount': ['sum', 'mean', 'count']\n",
    "}).reset_index()\n",
    "\n",
    "receiver_amounts.columns = ['Address', 'Total_Received', 'Avg_Received', 'Received_Count']\n",
    "# Merge to get complete picture\n",
    "address_amounts = pd.merge(sender_amounts, receiver_amounts, on='Address', how='outer').fillna(0)\n",
    "address_amounts['Net_Flow'] = address_amounts['Total_Received'] - address_amounts['Total_Sent']\n",
    "address_amounts['Transaction_Count'] = address_amounts['Sent_Count'] + address_amounts['Received_Count']\n",
    "# Sort by total transaction amount\n",
    "address_amounts = address_amounts.sort_values('Transaction_Count', ascending=False)\n",
    "print(\"\\nTop 10 addresses by transaction volume:\")\n",
    "print(address_amounts.head(10))"
   ]
  },
