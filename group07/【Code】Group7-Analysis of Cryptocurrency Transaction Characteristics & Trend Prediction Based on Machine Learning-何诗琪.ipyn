    "# --- Interactive Line Plot: BTC vs ETH Daily Transactions (Plotly) ---\n",
    "# Interactive version for better zoom and hover functionality. \n",
    "\n",
    "fig = px.line(daily_currency,\n",
    "              x='Date', y='Count', color='Currency',\n",
    "              title=\"BTC vs ETH Daily Transactions Over Time\",\n",
    "              labels={'Count': 'Number of Transactions'},\n",
    "              template='plotly_white')\n",
    "fig.update_layout(showlegend=True)\n",
    "fig.show(renderer=\"notebook\")"
   ]
  },
