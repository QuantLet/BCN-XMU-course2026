   "source": [
    "# --- Line Plot: Average Transaction Fee Over Time ---\n",
    "# Shows how the average transaction fee (for both BTC and ETH) changes daily.\n",
    "# Helps identify periods of high network congestion or fee spikes.\n",
    "\n",
    "avg_fee = df.groupby(['Timestamp_DMY', 'Currency'])['Transaction_Fee'].mean().unstack()\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "avg_fee.plot(ax=plt.gca(), linewidth=2)\n",
    "plt.title(\"Average Transaction Fee Over Time (BTC & ETH)\")\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"Average Fee\")\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
