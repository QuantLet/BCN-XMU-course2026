       "\n",
       "const float MAX_LINES = 256.;\n",
       "\n",
       "void main() {\n",
       "\tfloat depth = (MAX_LINES - 4. - id) / (MAX_LINES);\n",
       "\n",
       "\tvec2 position = position * scale + translate\n",
