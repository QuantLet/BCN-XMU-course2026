   "source": [
    "# --- Activity by hour of day ---\n",
    "# For top 100 most active addresses\n",
    "top_addresses = address_activity.head(100)['Address'].values\n",
    "# Filter transactions for these addresses\n",
    "top_address_txs = all_txs[all_txs['Address'].isin(top_addresses)]\n",
    "top_address_txs['Hour'] = top_address_txs['Timestamp'].dt.hour\n",
    "# Count transactions by hour for these addresses\n",
    "hour_activity = top_address_txs.groupby('Hour').size().reset_index(name='Transaction_Count')\n",
    "plt.figure(figsize=(12, 6))\n",
    "plt.bar(hour_activity['Hour'], hour_activity['Transaction_Count'])\n",
