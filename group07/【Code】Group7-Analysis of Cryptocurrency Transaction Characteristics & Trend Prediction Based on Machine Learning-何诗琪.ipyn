    "# --- Histogram: Transaction Fee Distribution (Log Scale) ---\n",
    "# Shows how transaction fees are distributed. Log scale helps visualize skew.\n",
    "# This plot includes both BTC and ETH transactions.\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.histplot(df['Transaction_Fee'], bins=100, log_scale=True, kde=True, color='orange')\n",
    "plt.title(\"Distribution of Transaction Fees (Log Scale)\")\n",
    "plt.xlabel(\"Transaction Fee\")\n",
    "plt.ylabel(\"Frequency\")\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
